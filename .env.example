AUTOCLIP_CONFIG=/app/config.yaml
AUTOCLIP_TTS_PROVIDER=google-gemini
# Native Google Gemini TTS uses Application Default Credentials from
# `gcloud auth application-default login`; never put a credential file here.
AUTOCLIP_GOOGLE_CLOUD_PROJECT=
AUTOCLIP_GOOGLE_TTS_MODEL=gemini-2.5-flash-tts
AUTOCLIP_GOOGLE_TTS_VOICE=Fenrir
AUTOCLIP_GOOGLE_TTS_PARALLELISM=6
AUTOCLIP_WORKSPACE=/app/workspaces
YOUTUBE_CLIENT_ID=your-google-oauth-client-id
YOUTUBE_CLIENT_SECRET=your-google-oauth-client-secret
YOUTUBE_REDIRECT_URI=http://localhost:9999/api/youtube/callback
YOUTUBE_API_KEY=

# Native RunPod Wan 2.2 through a local SSH tunnel.
# AutoClip itself only calls this fixed local address; do not put Pod IPs,
# SSH endpoints, or private-key paths in this file.
AUTOCLIP_WAN_ENABLED=false
AUTOCLIP_WAN_COMFY_URL=http://127.0.0.1:18188
AUTOCLIP_WAN_REQUEST_TIMEOUT_SECONDS=120
AUTOCLIP_WAN_GENERATION_TIMEOUT_SECONDS=900
AUTOCLIP_WAN_POLL_INTERVAL_SECONDS=2

# Optional GPU Thai narration through the same RunPod SSH connector.
AUTOCLIP_RUNPOD_F5_ENABLED=false

# RunPod monitor only. Keep real values in ignored .env, never in Git.
RUNPOD_SSH_HOST=
RUNPOD_SSH_PORT=22
RUNPOD_SSH_USER=root
RUNPOD_SSH_KEY_PATH=~/.ssh/id_ed25519_runpod
